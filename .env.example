# Supabase > your project > Connect (or Settings > API Keys).
# Use the publishable key (sb_publishable_...). The older anon key also works through the end of 2026.
# Never put a secret key (sb_secret_...) or the service_role key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
